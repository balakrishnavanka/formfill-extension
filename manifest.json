{
  "manifest_version": 3,
  "name": "FormFill Pro",
  "version": "1.1.0",
  "description": "Auto-fill forms with your saved personal information including name, gender, age, and Aadhar number.",
  "browser_specific_settings": {
    "gecko": {
      "id": "formfill-pro@local",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FormFill Pro"
  },
  "icons": {
    "16":  "icons/icon-16.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "debugger",
    "management"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "scripts": ["service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
